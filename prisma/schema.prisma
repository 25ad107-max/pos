generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  BILLING_STAFF
  STAFF
  DRIVER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  INACTIVE
}

enum SalaryType {
  PER_LOAD
  DAILY_WAGE
  MONTHLY
  CUSTOM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DRIVER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum LoadStatus {
  ASSIGNED
  ACCEPTED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  PENDING
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CREDIT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  driverProfile Driver?
  sessions     Session[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, isActive])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Customer {
  id             String        @id @default(cuid())
  customerNumber String        @unique
  name           String
  phone          String
  whatsapp       String?
  address        String?
  deliveryArea   String?
  customerType   String        @default("Individual")
  gstNumber      String?
  notes          String?
  status         RecordStatus  @default(ACTIVE)
  orders         Order[]
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime?

  @@index([name])
  @@index([phone])
}

model Material {
  id        String       @id @default(cuid())
  name      String       @unique
  unit      String       @default("Load")
  rate      Decimal      @db.Decimal(12, 2)
  isService Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  orders    Order[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  archivedAt DateTime?
}

model Driver {
  id                   String       @id @default(cuid())
  driverNumber         String       @unique
  name                 String
  phone                String
  alternatePhone       String?
  address              String?
  licenceNumber        String       @unique
  licenceExpiry        DateTime?
  joiningDate          DateTime?
  salaryType           SalaryType   @default(PER_LOAD)
  ratePerLoad          Decimal      @default(0) @db.Decimal(12, 2)
  baseSalary           Decimal      @default(0) @db.Decimal(12, 2)
  bankOrUpi            String?
  emergencyContact     String?
  notes                String?
  status               RecordStatus @default(ACTIVE)
  userId               String?      @unique
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedVehicles     Vehicle[]    @relation("AssignedDriver")
  loads                Load[]
  advances             DriverAdvance[]
  salaryPeriods        SalaryPeriod[]
  createdBy            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  archivedAt           DateTime?

  @@index([name])
  @@index([phone])
  @@index([status])
}

model Vehicle {
  id                String        @id @default(cuid())
  vehicleNumber     String        @unique
  vehicleType       String
  capacity          Decimal       @db.Decimal(10, 2)
  capacityUnit      String        @default("Ton")
  assignedDriverId  String?
  assignedDriver    Driver?       @relation("AssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  insuranceExpiry   DateTime?
  fitnessExpiry     DateTime?
  permitExpiry      DateTime?
  pollutionExpiry   DateTime?
  status            VehicleStatus @default(AVAILABLE)
  notes             String?
  loads             Load[]
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  archivedAt        DateTime?

  @@index([vehicleNumber])
  @@index([status])
  @@index([assignedDriverId])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  invoiceNumber   String?      @unique
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  materialId      String
  material        Material     @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity        Decimal      @db.Decimal(12, 2)
  unit            String
  rate            Decimal      @db.Decimal(12, 2)
  materialAmount  Decimal      @db.Decimal(12, 2)
  deliveryCharge  Decimal      @default(0) @db.Decimal(12, 2)
  otherCharges    Decimal      @default(0) @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal      @db.Decimal(12, 2)
  amountPaid      Decimal      @default(0) @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(CREDIT)
  status          OrderStatus  @default(PENDING)
  deliveryLocation String
  deliveryDate    DateTime?
  urgent          Boolean      @default(false)
  notes           String?
  loads           Load[]
  payments        Payment[]
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?

  @@index([customerId, createdAt])
  @@index([status, deliveryDate])
  @@index([paymentStatus])
}

model Load {
  id              String     @id @default(cuid())
  loadNumber      String     @unique
  orderId         String
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driverId        String
  driver          Driver     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId       String
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  quantity        Decimal    @db.Decimal(12, 2)
  driverRate      Decimal    @db.Decimal(12, 2)
  status          LoadStatus @default(ASSIGNED)
  deliveryDate    DateTime?
  deliveredAt     DateTime?
  driverNotes     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([driverId, status, deliveryDate])
  @@index([vehicleId, status])
  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  receivedAt    DateTime      @default(now())
  reference     String?
  notes         String?
  createdBy     String?
  createdAt     DateTime      @default(now())
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique
  date          DateTime @default(now())
  category      String
  amount        Decimal  @db.Decimal(12, 2)
  vehicleId     String?
  driverId      String?
  description   String
  receiptUrl    String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date, category])
}

model DriverAdvance {
  id          String        @id @default(cuid())
  driverId    String
  driver      Driver        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  date        DateTime      @default(now())
  amount      Decimal       @db.Decimal(12, 2)
  reason      String
  method      PaymentMethod
  notes       String?
  createdBy   String?
  createdAt   DateTime      @default(now())

  @@index([driverId, date])
}

model SalaryPeriod {
  id           String   @id @default(cuid())
  driverId     String
  driver       Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  periodStart  DateTime
  periodEnd    DateTime
  loadEarnings Decimal  @default(0) @db.Decimal(12, 2)
  bonus        Decimal  @default(0) @db.Decimal(12, 2)
  otherEarnings Decimal @default(0) @db.Decimal(12, 2)
  advances     Decimal  @default(0) @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  netSalary    Decimal  @default(0) @db.Decimal(12, 2)
  paidAt       DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([driverId, periodStart, periodEnd])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  category  String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
